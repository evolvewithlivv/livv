# ─────────────────────────────────────────
# LIVV · Environment (copy to .env.local for local dev)
# In Vercel: Project → Settings → Environment Variables
# ─────────────────────────────────────────

# Public site URL (no trailing slash)
# Local: http://localhost:3000
# Prod:  https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────
# Supabase
# Dashboard → Project Settings → API
# ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only (B1 webhook entitlement writes). NEVER prefix with NEXT_PUBLIC_.
# Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Stripe Dashboard → Developers → Webhooks → endpoint signing secret
# Endpoint URL: https://your-domain.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from Stripe → Products (recurring prices)
STRIPE_PRICE_RISE=price_...
STRIPE_PRICE_APEX=price_...
STRIPE_PRICE_CIRCLE=price_...

# Non-production QA only. Never set this in Production.
NEXT_PUBLIC_LIVV_DEMO_UNLOCK=0
